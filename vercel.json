{
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "templates/**",
        "data/**",
        "static/**",
        "public/**",
        "database/**"
      ],
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
