# Optional dependency (PDF export)
REPORTLAB_AVAILABLE = True
try:
    from reportlab.lib.pagesizes import A4, landscape
    from reportlab.pdfgen import canvas
except ModuleNotFoundError:
    REPORTLAB_AVAILABLE = False


@app.get("/assets/report/pdf")
def assets_report_pdf():
    if not REPORTLAB_AVAILABLE:
        return (
            "PDF export requires ReportLab. Install it with: python -m pip install reportlab",
            503,
        )

    dept = get_current_department()

    # support multiple sections: ?section=Acaricide&section=Pharma
    sections = request.args.getlist("section")
    status = (request.args.get("status") or "").strip()
    criticality = (request.args.get("criticality") or "").strip()

    items = [a for a in ASSETS if (a.get("department") or "Engineering") == dept]

    if sections:
        items = [a for a in items if (a.get("section") or "") in sections]
    if status:
        items = [a for a in items if (a.get("status") or "") == status]
    if criticality:
        items = [a for a in items if (a.get("criticality") or "") == criticality]

    buf = io.BytesIO()
    c = canvas.Canvas(buf, pagesize=landscape(A4))
    width, height = landscape(A4)

    title = f"Asset Register Report - {dept}"
    c.setFont("Helvetica-Bold", 14)
    c.drawString(30, height - 30, title)

    meta = (
        f"Sections: {', '.join(sections) if sections else 'All'} | "
        f"Status: {status or 'All'} | "
        f"Criticality: {criticality or 'All'} | "
        f"Count: {len(items)}"
    )
    c.setFont("Helvetica", 9)
    c.drawString(30, height - 50, meta)

    # Table header
    y = height - 80
    c.setFont("Helvetica-Bold", 9)
    headers = ["Asset ID", "Asset Name", "Section", "Status", "Criticality", "Serial"]
    xs = [30, 140, 360, 470, 560, 640]
    for i, h in enumerate(headers):
        c.drawString(xs[i], y, h)

    c.setFont("Helvetica", 9)
    y -= 14

    def status_label(st):
        return "Operational" if st == "operational" else ("Maintenance" if st == "maintenance" else "Out of Service")

    for a in items:
        if y < 40:
            c.showPage()
            y = height - 40
            c.setFont("Helvetica", 9)

        row = [
            (a.get("asset_id") or ""),
            (a.get("asset_name") or ""),
            (a.get("section") or ""),
            status_label(a.get("status") or ""),
            (a.get("criticality") or ""),
            (a.get("serial_no") or "—"),
        ]
        for i, val in enumerate(row):
            c.drawString(xs[i], y, str(val)[:60])
        y -= 12

    c.showPage()
    c.save()

    pdf = buf.getvalue()
    buf.close()

    return Response(
        pdf,
        mimetype="application/pdf",
        headers={"Content-Disposition": "attachment; filename=assets_report.pdf"},
    )




