        link_open_work_order=url_for(
            "maintenance_schedule_step1",
            section=(asset.get("section") or "").strip(),
            asset_uid=asset_uid,
            from_asset="1",
        ),
    )
    return render_template("assets/assets_success.html", **ctx)


