# ==============================================================================
# EABC / OPSLOOM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your local or production environment.
# ==============================================================================

# Node runtime environment ('development' or 'production')
NODE_ENV=development

# Network Host and Port binding
# Use '0.0.0.0' to allow access across a local organizational network (LAN),
# or '127.0.0.1' for strictly local loopback on a single machine.
HOST=0.0.0.0
PORT=3000

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Standard PostgreSQL Connection URL (Preferred for Docker / Cloud / PaaS)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/eabc_db

# Option B: Individual Connection Parameters (Used if DATABASE_URL is not set)
SQL_HOST=localhost
PGPORT=5432
SQL_USER=postgres
SQL_PASSWORD=postgres_password
SQL_DB_NAME=eabc_db

# Optional: Admin credentials if running DDL migrations with a privileged user
# SQL_ADMIN_USER=postgres
# SQL_ADMIN_PASSWORD=postgres_password

# ------------------------------------------------------------------------------
# SYSTEM & SESSION SECURITY
# ------------------------------------------------------------------------------
# Session signing key (minimum 32 random characters in production)
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# System Timezone (e.g. Africa/Nairobi, Europe/London, America/New_York)
TZ=Africa/Nairobi

# Initial Super-Administrator Credentials (used for initial bootstrapping)
ADMIN_PRIMARY_EMAIL=opsloom.ke@gmail.com
ADMIN_LOGIN_PASSWORD=

# Inactivity session timeout in minutes (default 30)
SESSION_TIMEOUT_MINUTES=30

# Local development upload directory. Production must use a durable mounted disk.
UPLOADS_DIR=./static/uploads

# Temporary containment for legacy global workspace state. Required in staging/production.
WORKSPACE_SERIAL_GUARD=false

# ------------------------------------------------------------------------------
# OPTIONAL: SMTP NOTIFICATION & REPORT DELIVERY
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=operations@yourcompany.co.ke
# SMTP_PASS=your_app_specific_password
# MAIL_FROM="EABC Maintenance Office" <operations@yourcompany.co.ke>

# ------------------------------------------------------------------------------
# OPTIONAL: AI RELIABILITY & RCA ASSISTANT (Google Gemini API)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
